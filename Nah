-- << 4. SCANNER UTILITIES >>

-- Villains: Items in workspace.MobSpawnGroup that have a "ChestRef" inside the "Spawn" area
local function scanVillains()
    local results = {}
    local spawnGroup = Workspace:FindFirstChild("MobSpawnGroup")
    if spawnGroup then
        for _, group in ipairs(spawnGroup:GetChildren()) do
            local spawnArea = group:FindFirstChild("Spawn")
            local hasChest = false

            if spawnArea and spawnArea:FindFirstChild("ChestRef") then
                hasChest = true
            else
                for _, child in ipairs(group:GetDescendants()) do
                    if child.Name == "ChestRef" and child.Parent and child.Parent.Name == "Spawn" then
                        hasChest = true
                        break
                    end
                end
            end

            if hasChest then
                table.insert(results, group.Name)
            end
        end
    end
    if #results == 0 then table.insert(results, "No Spawns With ChestRef") end
    return results
end

-- Mobs Near Player: workspace.Mob with name deduplication (maximum 1 of each name)
local function scanMobsNear()
    local results = {}
    local seen = {}
    local mobFolder = Workspace:FindFirstChild("Mob") or Workspace:FindFirstChild("Mobs")
    if mobFolder then
        for _, mob in ipairs(mobFolder:GetChildren()) do
            if mob:IsA("Model") and not seen[mob.Name] then
                seen[mob.Name] = true
                table.insert(results, mob.Name)
            end
        end
    end
    if #results == 0 then table.insert(results, "No Mobs Found") end
    return results
end

-- Weapons: workspace.NpcWeapon
local function scanWeapons()
    local results = {}
    local folder = Workspace:FindFirstChild("NpcWeapon")
    if folder then
        for _, item in ipairs(folder:GetChildren()) do
            table.insert(results, item.Name)
        end
    end
    if #results == 0 then table.insert(results, "No Weapons Found") end
    return results
end

-- Islands: workspace.island
local function scanIslands()
    local results = {}
    local folder = Workspace:FindFirstChild("island") or Workspace:FindFirstChild("Island") or Workspace:FindFirstChild("islands")
    if folder then
        for _, item in ipairs(folder:GetChildren()) do
            table.insert(results, item.Name)
        end
    end
    if #results == 0 then table.insert(results, "No Islands Found") end
    return results
end

-- Helper to safely refresh Dropdown items
local function refreshDropdown(dropdown, values)
