        dropdown:SetValues(values)
    end
end

-- << 5. TARGET POSITIONING & KINEMATICS ENGINE >>

local function getCharacterParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not hum or hum.Health <= 0 or not hrp then return nil, nil end
    return char, hrp
end

local function getTargetCFrame(instance)
    if not instance then return nil end
    if instance:IsA("Model") then
        if instance.PrimaryPart then return instance.PrimaryPart.CFrame end
        local part = instance:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.CFrame end
        return instance:GetPivot()
    elseif instance:IsA("BasePart") then
        return instance.CFrame
    end
    return nil
end

local function getActiveVillainTarget()
    local spawnGroup = Workspace:FindFirstChild("MobSpawnGroup")
    if not spawnGroup then return nil end

    for folderName, isSelected in pairs(State.VillainsSelected) do
        if isSelected == true then
            local group = spawnGroup:FindFirstChild(folderName)
            if group then
                -- Target ChestRef (can be an ObjectValue, Model, or Part)
                local chest = group:FindFirstChild("ChestRef", true)
                if chest then
                    if chest:IsA("ObjectValue") and chest.Value and chest.Value:IsA("PVInstance") then
                        return chest.Value
                    elseif chest:IsA("BasePart") or chest:IsA("Model") then
                        return chest
                    end
                end
                -- Target mob inside group if chest is not directly resolved
                for _, child in ipairs(group:GetChildren()) do
                    if child:IsA("Model") and child.Name ~= "Spawn" then
                        return child
                    end
                end
            end
        end
    end
    return nil
end

local function getActiveMobTarget(playerPos)
    local mobFolder = Workspace:FindFirstChild("Mob") or Workspace:FindFirstChild("Mobs")
    if not mobFolder then return nil end

    local nearestMob = nil
    local shortestDist = math.huge

    for _, mob in ipairs(mobFolder:GetChildren()) do
        if mob:IsA("Model") and State.MobsSelected[mob.Name] == true then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health > 0 then
                local cf = getTargetCFrame(mob)
                if cf then
                    local dist = (cf.Position - playerPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestMob = mob
                    end
                end
            end
        end
    end
    return nearestMob
end

-- Positions player flat on top of the mob/chest, lying down and facing directly at it
local function applyLyingHover(hrp, targetInstance, distance)
    local targetCF = getTargetCFrame(targetInstance)
    if not targetCF then return end

    local targetPos = targetCF.Position
    local hoverPos = targetPos + Vector3.new(0, distance, 0)
    local targetLook = targetCF.LookVector

    -- Calculate horizontal rotation
    local flatLook = Vector3.new(targetLook.X, 0, targetLook.Z)
    local baseRot = CFrame.new()
    if flatLook.Magnitude > 0.001 then
        baseRot = CFrame.lookAt(Vector3.zero, flatLook.Unit)
    end

    -- Rotate -90 degrees on the X-axis so character lies prone (facing straight down toward the target)
    local finalCF = CFrame.new(hoverPos) * baseRot * CFrame.Angles(-math.rad(90), 0, 0)

    hrp.CFrame = finalCF
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

-- Kinematic loop connected to Heartbeat
RunService.Heartbeat:Connect(function()
    local char, hrp = getCharacterParts()
    if not char or not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")

    if State.VillainsActive then
        local target = getActiveVillainTarget()
        if target then
            if hum then hum.PlatformStand = true end
            applyLyingHover(hrp, target, State.VillainsDistance)
        end
    elseif State.MobsActive then
        local target = getActiveMobTarget(hrp.Position)
        if target then
            if hum then hum.PlatformStand = true end
            applyLyingHover(hrp, target, State.MobsDistance)
        end
    else
        if hum and hum.PlatformStand then
            hum.PlatformStand = false
        end
    end
end)

