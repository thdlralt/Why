-- << 4. SCANNER SERVICES >>

-- Villains: Scans workspace.MobSpawnGroup. Only includes groups containing 'ChestRef' in 'Spawn'
local function scanVillains()
    local results = {}
    local spawnGroup = Workspace:FindFirstChild("MobSpawnGroup")
    if spawnGroup then
        for _, group in ipairs(spawnGroup:GetChildren()) do
            local spawnFolder = group:FindFirstChild("Spawn")
            local hasChest = false

            if spawnFolder and spawnFolder:FindFirstChild("ChestRef") then
                hasChest = true
            elseif group:FindFirstChild("ChestRef", true) then
                hasChest = true
            end

            if hasChest then
                table.insert(results, group.Name)
            end
        end
    end
    if #results == 0 then table.insert(results, "None Found") end
    return results
end

-- Mobs: Scans workspace.Mob. Deduplicates names so no duplicates appear
local function scanMobsNear()
    local results = {}
    local seen = {}
    local mobFolder = Workspace:FindFirstChild("Mob") or Workspace:FindFirstChild("Mobs")

    if mobFolder then
        for _, mob in ipairs(mobFolder:GetChildren()) do
            if mob:IsA("Model") and not seen[mob.Name] then
                seen[mob.Name] = true
                table.insert(results, mob.Name)
            end
        end
    end
    if #results == 0 then table.insert(results, "None Found") end
    return results
end

-- Weapons: Scans workspace.NpcWeapon
local function scanWeapons()
    local results = {}
    local weaponFolder = Workspace:FindFirstChild("NpcWeapon")
    if weaponFolder then
        for _, item in ipairs(weaponFolder:GetChildren()) do
            table.insert(results, item.Name)
        end
    end
    if #results == 0 then table.insert(results, "None Found") end
    return results
end

-- Islands: Scans workspace.island
local function scanIslands()
    local results = {}
    local islandFolder = Workspace:FindFirstChild("island") or Workspace:FindFirstChild("Island") or Workspace:FindFirstChild("islands")
    if islandFolder then
        for _, item in ipairs(islandFolder:GetChildren()) do
            table.insert(results, item.Name)
        end
    end
    if #results == 0 then table.insert(results, "None Found") end
    return results
end

-- << 5. TARGET LOCATORS >>

local function getRoot(character)
    return character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"))
end

local function getTargetCFrame(instance)
    if not instance then return nil end
    if instance:IsA("Model") then
        local pPart = instance.PrimaryPart or instance:FindFirstChild("HumanoidRootPart") or instance:FindFirstChildWhichIsA("BasePart")
        return pPart and pPart.CFrame or instance:GetPivot()
    elseif instance:IsA("BasePart") then
        return instance.CFrame
    end
    return nil
end

local function findActiveVillainTarget()
    local spawnGroup = Workspace:FindFirstChild("MobSpawnGroup")
    if not spawnGroup then return nil end

    for folderName, isSelected in pairs(State.VillainsSelected) do
        if isSelected then
            local group = spawnGroup:FindFirstChild(folderName)
            if group then
                -- Check for ChestRef instance
                local chest = group:FindFirstChild("ChestRef", true)
                if chest then
                    local chestTarget = chest:IsA("ObjectValue") and chest.Value or chest
                    if chestTarget then return chestTarget end
                end

                -- If mob model exists inside the group
                for _, child in ipairs(group:GetChildren()) do
                    if child:IsA("Model") and child.Name ~= "Spawn" then
                        return child
                    end
                end
            end
        end
    end
    return nil
end

local function findActiveMobTarget()
    local mobFolder = Workspace:FindFirstChild("Mob") or Workspace:FindFirstChild("Mobs")
    if not mobFolder then return nil end

    for _, mob in ipairs(mobFolder:GetChildren()) do
        if mob:IsA("Model") and State.MobsSelected[mob.Name] then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health > 0 then
                return mob
            end
        end
    end
    return nil
end

-- << 6. KINEMATICS & HOVER ENGINE (Lying on top facing mob) >>

-- Pitching -90 degrees on the X-axis positions the character belly-down facing the mob
local function hoverLyingDown(hrp, targetInstance, distance)
    local targetCF = getTargetCFrame(targetInstance)
    if not targetCF then return end

    local targetPos = targetCF.Position
    local hoverPos = targetPos + Vector3.new(0, distance, 0)

    -- Extract horizontal direction of target
    local look = targetCF.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    local baseRotation = if flatLook.Magnitude > 0.001 then CFrame.lookAt(Vector3.zero, flatLook) else CFrame.identity

    -- CFrame.Angles(-math.pi/2, 0, 0) rotates the character horizontal (facing directly down)
    local finalCFrame = CFrame.new(hoverPos) * baseRotation * CFrame.Angles(-math.rad(90), 0, 0)

    hrp.CFrame = finalCFrame
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

-- Heartbeat loop to keep player glued overhead
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = getRoot(char)
    if not hrp then return end

    if State.VillainsActive then
        local target = findActiveVillainTarget()
        if target then
            hoverLyingDown(hrp, target, State.VillainsDistance)
        end
    elseif State.MobsActive then
        local target = findActiveMobTarget()
        if target then
            hoverLyingDown(hrp, target, State.MobsDistance)
        end
    end
end)

