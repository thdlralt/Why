-- << 4. WORKSPACE SCANNING FUNCTIONS >>

-- Villains: Scans workspace.MobSpawnGroup. Only includes groups that contain 'ChestRef' in their 'Spawn' folder
local function scanVillains()
    local results = {}
    local spawnGroup = Workspace:FindFirstChild("MobSpawnGroup")
    if spawnGroup then
        for _, group in ipairs(spawnGroup:GetChildren()) do
            local spawnArea = group:FindFirstChild("Spawn")
            local hasChest = false
            
            if spawnArea and spawnArea:FindFirstChild("ChestRef") then
                hasChest = true
            else
                for _, descendant in ipairs(group:GetDescendants()) do
                    if descendant.Name == "ChestRef" and descendant.Parent and descendant.Parent.Name == "Spawn" then
                        hasChest = true
                        break
                    end
                end
            end

            if hasChest then
                table.insert(results, group.Name)
            end
        end
    end
    if #results == 0 then
        table.insert(results, "No Villains With ChestRef")
    end
    return results
end

-- Mobs near player: Scans workspace.Mob with deduplication (maximum 1 of each name)
local function scanMobsNear()
    local results = {}
    local seen = {}
    local mobFolder = Workspace:FindFirstChild("Mob") or Workspace:FindFirstChild("Mobs")
    if mobFolder then
        for _, item in ipairs(mobFolder:GetChildren()) do
            if item:IsA("Model") and not seen[item.Name] then
                seen[item.Name] = true
                table.insert(results, item.Name)
            end
        end
    end
    if #results == 0 then
        table.insert(results, "No Mobs Found")
    end
    return results
end

-- Weapons: Scans workspace.NpcWeapon
local function scanWeapons()
    local results = {}
    local folder = Workspace:FindFirstChild("NpcWeapon")
    if folder then
        for _, item in ipairs(folder:GetChildren()) do
            table.insert(results, item.Name)
        end
    end
    if #results == 0 then
        table.insert(results, "No Weapons Found")
    end
    return results
end

-- Islands: Scans workspace.island
