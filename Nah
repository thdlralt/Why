            FpsData.AnimatedConnections = {}
            if FpsData.ShineCheckConnection then
                pcall(function() FpsData.ShineCheckConnection:Disconnect() end)
                FpsData.ShineCheckConnection = nil
            end
            FpsData.GUI:Destroy()
            FpsData.GUI = nil
        end
    end
end

